PORT=4000
SERVICE_NAME=api-gateway
NODE_ENV=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars
JWT_ISSUER=irctc-user-service
JWT_AUDIENCE=irctc-api

# Microservice URLs
USER_SERVICE_URL=http://localhost:5001
BOOKING_SERVICE_URL=http://localhost:5002
PAYMENT_SERVICE_URL=http://localhost:5003
SEARCH_SERVICE_URL=http://localhost:5004
NOTIFICATION_SERVICE_URL=http://localhost:5005
ADMIN_SERVICE_URL=http://localhost:5006
