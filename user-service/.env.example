PORT=5001
SERVICE_NAME=user-service
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://username:password@localhost:5432/user_service_database
REDIS_URL=redis://localhost:6379
ALLOWED_ORIGINS=http://localhost:4000
OTP_RATE_MAX_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_TTL=300
OTP_HMAC_SECRET=your_super_secret_hmac_key_for_otp
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=IRCTC NextGen e-Ticketing
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_characters_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=irctc-user-service
JWT_AUDIENCE=irctc-api
COOKIE_DOMAIN=
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SEC=60
AUTH_REFRESH_RATE_LIMIT_MAX=30
AUTH_REFRESH_RATE_LIMIT_WINDOW_SEC=60
